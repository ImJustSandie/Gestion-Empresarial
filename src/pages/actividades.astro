---
import AppHeader from "../components/AppHeader.tsx";
import AppFooter from "../components/AppFooter.tsx";
import ActividadesView from "../components/ActividadesView.tsx";
import "../styles/global.css";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <title>Cursos / Actividades - Gestión Empresarial</title>
  </head>
  <body class="bg-gray-50 text-gray-900 min-h-screen flex flex-col">
    <AppHeader client:load currentPath="/actividades" />
    <div class="flex-1">
      <ActividadesView client:load />
    </div>
    <AppFooter client:load />
  </body>
</html>
