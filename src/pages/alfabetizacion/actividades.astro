---
import AppHeader from "../../components/AppHeader.tsx";
import AppFooter from "../../components/AppFooter.tsx";
import ActividadesIndice from "../../components/ActividadesIndice.tsx";
import "../../styles/global.css";
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <title>Actividades · Alfabetización IA - Gestión Empresarial</title>
  </head>
  <body class="bg-gray-50 text-gray-900 min-h-screen flex flex-col">
    <AppHeader client:load currentPath="/alfabetizacion" />
    <main class="w-full px-6 sm:px-10 lg:px-14 py-8 flex-1">
      <a
        href="/alfabetizacion"
        class="inline-flex items-center gap-1 text-sm bg-white border border-slate-200 px-4 py-2 rounded-full font-semibold text-slate-700 hover:border-[#7C5CE9] hover:text-[#5932EA] transition"
      >
        ← Volver a los bloques de contenido
      </a>

      <div class="mt-6">
        <ActividadesIndice client:load />
      </div>
    </main>
    <AppFooter client:load />
  </body>
</html>
