---
import AppHeader from "../../../components/AppHeader.tsx";
import AppFooter from "../../../components/AppFooter.tsx";
import TipoActividad from "../../../components/TipoActividad.tsx";
import "../../../styles/global.css";
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <title>Detector de alucinaciones · Actividades - Alfabetización IA</title>
  </head>
  <body class="bg-gray-50 text-gray-900 min-h-screen flex flex-col">
    <AppHeader client:load currentPath="/alfabetizacion" />
    <main class="container mx-auto px-4 py-6 sm:py-8 max-w-4xl flex-1">
      <TipoActividad tipo="detector" client:load />
    </main>
    <AppFooter client:load />
  </body>
</html>
