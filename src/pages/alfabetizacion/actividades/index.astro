---
import AppHeader from "../../../components/AppHeader.tsx";
import ActividadesIndice from "../../../components/ActividadesIndice.tsx";
import "../../../styles/global.css";
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <title>Actividades · Alfabetización IA - Gestión Empresarial</title>
  </head>
  <body class="bg-gray-50 text-gray-900 min-h-screen">
    <AppHeader client:load currentPath="/alfabetizacion" />
    <div class="container mx-auto px-4 py-6 sm:py-10 max-w-4xl">
      <a href="/alfabetizacion" class="text-xs bg-white border px-3 py-1.5 rounded-full font-semibold hover:border-gray-400">← Alfabetización IA</a>

      <div class="text-center max-w-2xl mx-auto mt-6 mb-8">
        <p class="text-xs font-bold uppercase tracking-widest text-emerald-600">Módulo de actividades · Alfabetización IA</p>
        <h1 class="text-3xl sm:text-4xl font-extrabold mt-2">🧪 Laboratorio de actividades</h1>
        <p class="text-sm text-gray-600 mt-2">
          Elige un tipo de actividad para empezar. Evalúa respuestas de IA sin necesidad de construir una IA real.
          Tu progreso se guarda en este navegador.
        </p>
      </div>

      <ActividadesIndice client:load />

      <div class="mt-8 text-center">
        <a href="/alfabetizacion" class="inline-block px-6 py-3 rounded-2xl bg-gray-900 text-white text-sm font-bold hover:bg-gray-700 transition">
          ← Volver a los bloques de contenido
        </a>
      </div>
    </div>
  </body>
</html>
