---
import AppHeader from "../../components/AppHeader.tsx";
import AppFooter from "../../components/AppFooter.tsx";
import LessonRenderer from "../../components/LessonRenderer.tsx";
import { getAllLessons, getLessonById, getLessonsByBlock } from "../../utils/lessons.ts";
import "../../styles/global.css";

export function getStaticPaths() {
  return getAllLessons().map((l) => ({ params: { id: l.meta.id } }));
}

const { id } = Astro.params;
const lesson = getLessonById(id ?? "");
const blockLessons = lesson?.meta.blockId ? getLessonsByBlock(lesson.meta.blockId) : [];
const idx = blockLessons.findIndex((l) => l.meta.id === id);
const prev = idx > 0 ? blockLessons[idx - 1] : null;
const next = idx >= 0 && idx < blockLessons.length - 1 ? blockLessons[idx + 1] : null;
const backHref = lesson?.meta.blockId ? `/alfabetizacion?bloque=${lesson.meta.blockId}` : "/alfabetizacion";
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <title>{lesson ? lesson.meta.title : "No encontrada"} - Lecciones</title>
  </head>
  <body class="bg-gray-50 text-gray-900 min-h-screen flex flex-col">
    <AppHeader client:load currentPath="/alfabetizacion" />
    <main class="px-4 sm:px-6 py-6 sm:py-8 max-w-4xl mx-auto flex-1 w-full">
      <a href={backHref} class="inline-flex items-center gap-1 text-sm bg-white border border-slate-200 px-4 py-2 rounded-full font-semibold text-slate-700 hover:border-[#7C5CE9] hover:text-[#5932EA] transition">← Volver al bloque</a>
      {!lesson && (
        <div class="bg-white border border-slate-200 rounded-3xl p-10 mt-5 text-center">
          <p class="font-bold text-lg">Lección no encontrada: {id}</p>
        </div>
      )}
      {lesson && (
        <article class="bg-white border border-slate-200/90 rounded-3xl mt-5 shadow-xs overflow-hidden">
          <header class="bg-gradient-to-br from-[#F3F0FF] via-white to-white border-b border-slate-100 px-6 sm:px-12 pt-8 sm:pt-10 pb-8">
            <p class="inline-flex items-center gap-2 text-xs font-extrabold tracking-widest text-[#5932EA] bg-white border border-[#DDD6FE] px-3 py-1.5 rounded-full uppercase">{lesson.meta.code} · {lesson.meta.block}</p>
            <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 mt-4 leading-tight">{lesson.meta.title}</h1>
            {lesson.meta.description && <p class="text-base sm:text-lg text-slate-600 mt-3 leading-relaxed max-w-2xl">{lesson.meta.description}</p>}
          </header>
          <div class="px-6 sm:px-12 py-8 sm:py-10">
            <LessonRenderer lesson={lesson} client:load />
          </div>
        </article>
      )}
      {lesson && (prev || next) && (
        <div class="mt-6 grid sm:grid-cols-2 gap-4">
          {prev ? (
            <a href={`/lecciones/${prev.meta.id}`} class="text-left bg-white border-2 border-slate-200 rounded-2xl p-5 hover:border-[#7C5CE9] transition">
              <p class="text-sm text-slate-500">← Anterior · {prev.meta.code}</p>
              <p class="font-bold text-lg mt-0.5">{prev.meta.title}</p>
            </a>
          ) : <span />}
          {next ? (
            <a href={`/lecciones/${next.meta.id}`} class="text-right bg-[#5932EA] text-white rounded-2xl p-5 hover:bg-[#4E2AD0] transition">
              <p class="text-sm text-white/75">Siguiente · {next.meta.code} →</p>
              <p class="font-bold text-lg mt-0.5">{next.meta.title}</p>
            </a>
          ) : <span />}
        </div>
      )}
    </main>
    <AppFooter client:load />
  </body>
</html>
